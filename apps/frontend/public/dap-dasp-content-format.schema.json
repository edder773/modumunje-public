{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modumunje.com/dap-dasp-content-format.schema.json",
  "title": "모두의 문제집 DAP·DAsP 이론·문제 가져오기 형식",
  "description": "현재 모두의 문제집 관리자 콘텐츠 가져오기에서 사용하는 DAP·DAsP JSON 형식입니다. theories와 questions 배열을 채운 뒤 미리보기 검증을 통과한 데이터만 적용합니다.",
  "type": "object",
  "required": [
    "theories",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "theories": {
      "type": "array",
      "description": "DAP·DAsP 이론 목록입니다.",
      "items": {
        "$ref": "#/$defs/theory"
      }
    },
    "questions": {
      "type": "array",
      "description": "DAP·DAsP 객관식·복수정답·DAP 실기형 문제 목록입니다.",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "sharedSubject": {
      "type": "string",
      "enum": [
        "전사아키텍처 이해",
        "데이터 요건 분석",
        "데이터 표준화",
        "데이터 모델링"
      ]
    },
    "dapSubject": {
      "type": "string",
      "enum": [
        "전사아키텍처 이해",
        "데이터 요건 분석",
        "데이터 표준화",
        "데이터 모델링",
        "데이터베이스 설계와 이용",
        "데이터 품질 관리 이해"
      ]
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "theory": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "topic",
        "examScope",
        "summary",
        "content",
        "keywords",
        "sortOrder",
        "active"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "이론 고유 ID입니다. 기존 theories.id와 겹치지 않는 양의 정수를 사용합니다."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "이론 목록과 상세 화면에 표시할 제목입니다."
        },
        "category": {
          "type": "string",
          "description": "공식 과목명입니다. examScope와 호환되는 과목만 사용할 수 있습니다."
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "description": "과목 안에서 이론을 묶는 소주제명입니다."
        },
        "examScope": {
          "type": "string",
          "enum": [
            "DASP",
            "DAP",
            "DA"
          ],
          "description": "DASP는 DAsP 전용, DAP는 DAP 전용, DA는 두 과정의 공통 콘텐츠입니다. 화면 표시는 DAsP이지만 저장 코드는 DASP입니다."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "이론 목록 카드에 표시할 짧은 학습 요약입니다."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown 형식의 이론 본문입니다. 번호가 있는 절, 표, 코드 블록 등을 사용할 수 있으며 코드 펜스는 짝이 맞아야 합니다."
        },
        "reviewAnswers": {
          "type": "string",
          "description": "본문의 복습 문제에 대한 Markdown 정답·해설입니다. 복습 문제가 없으면 생략하거나 빈 문자열을 사용합니다."
        },
        "keywords": {
          "$ref": "#/$defs/stringList",
          "description": "검색과 핵심 개념 표시에 사용할 중복 없는 키워드 배열입니다. DB에는 JSON 문자열로 저장됩니다."
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 1,
          "description": "같은 과목 안에서의 이론 표시 순서입니다."
        },
        "active": {
          "type": "boolean",
          "description": "true이면 공개 대상, false이면 초안·비활성 데이터입니다."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "선택 필드입니다. ISO 8601 생성 시각이며 생략하면 가져오기 시각을 사용합니다."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "선택 필드입니다. ISO 8601 수정 시각이며 생략하면 가져오기 시각을 사용합니다."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "examScope": {
                "enum": [
                  "DASP",
                  "DA"
                ]
              }
            },
            "required": [
              "examScope"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "$ref": "#/$defs/sharedSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "examScope": {
                "const": "DAP"
              }
            },
            "required": [
              "examScope"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "$ref": "#/$defs/dapSubject"
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "category",
        "topic",
        "examScope",
        "difficulty",
        "kind",
        "prompt",
        "choices",
        "correctAnswers",
        "explanation",
        "tags",
        "active"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "문제 고유 ID입니다. 기존 questions.id와 겹치지 않는 양의 정수를 사용합니다."
        },
        "category": {
          "type": "string",
          "description": "공식 과목명입니다. examScope와 호환되는 과목만 사용할 수 있습니다."
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "description": "과목 안에서 문제를 묶는 소주제명입니다."
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 1,
          "description": "선택 필드입니다. 문제 표시 순서이며 생략하면 questions 배열의 순서를 사용합니다."
        },
        "examScope": {
          "type": "string",
          "enum": [
            "DASP",
            "DAP",
            "DA"
          ],
          "description": "DASP는 DAsP 전용, DAP는 DAP 전용, DA는 두 과정의 공통 콘텐츠입니다."
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "하",
            "중",
            "상"
          ],
          "description": "학습 난이도입니다."
        },
        "difficultyRationale": {
          "type": "string",
          "description": "선택 필드입니다. 해당 난이도로 판단한 근거를 적습니다."
        },
        "kind": {
          "type": "string",
          "enum": [
            "single",
            "multiple",
            "descriptive"
          ],
          "description": "single은 단일 정답, multiple은 복수 정답, descriptive는 DAP 실기형입니다."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown 형식의 문제 본문입니다."
        },
        "choices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "객관식·복수정답 선택지 배열입니다. DAP 실기형은 빈 배열을 사용합니다. DB에는 JSON 문자열로 저장됩니다."
        },
        "correctAnswers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "정답 선택지의 0 기반 인덱스 배열입니다. 첫 번째 선택지는 0입니다. DAP 실기형은 빈 배열을 사용합니다."
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown 형식의 정답·오답 해설입니다. 실기형은 직접 채점 가능한 모범답안과 상세 해설을 포함합니다."
        },
        "theoryId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "선택 필드입니다. 연결할 활성 이론 ID이며 과목과 시험 범위가 호환되어야 합니다."
        },
        "tags": {
          "$ref": "#/$defs/stringList",
          "description": "검색, 범위 필터, 문제 품질 점검에 사용할 중복 없는 태그 배열입니다."
        },
        "scoringCriteria": {
          "$ref": "#/$defs/stringList",
          "description": "DAP 실기형 채점 기준입니다. 실기형에서는 한 개 이상 필요하고 객관식에서는 생략합니다."
        },
        "requiredConcepts": {
          "$ref": "#/$defs/stringList",
          "description": "DAP 실기형 답안에 반드시 포함되어야 할 핵심 개념입니다. 실기형에서는 한 개 이상 필요합니다."
        },
        "acceptableAlternatives": {
          "$ref": "#/$defs/stringList",
          "description": "DAP 실기형에서 정답으로 인정할 수 있는 대체 표현이나 절차입니다."
        },
        "deductionConditions": {
          "$ref": "#/$defs/stringList",
          "description": "DAP 실기형에서 부분 감점할 조건입니다."
        },
        "errorConditions": {
          "$ref": "#/$defs/stringList",
          "description": "DAP 실기형에서 명백한 오류로 판단할 조건입니다."
        },
        "practiceScope": {
          "type": "string",
          "enum": [
            "general",
            "theory_only"
          ],
          "description": "선택 필드입니다. general은 일반 문제 풀이·모의고사 후보, theory_only는 이론 연결 전용 문제입니다. 기본값은 general입니다."
        },
        "active": {
          "type": "boolean",
          "description": "true이면 출제 대상, false이면 초안·비활성 데이터입니다."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "선택 필드입니다. ISO 8601 생성 시각이며 생략하면 가져오기 시각을 사용합니다."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "선택 필드입니다. ISO 8601 수정 시각이며 생략하면 가져오기 시각을 사용합니다."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "examScope": {
                "enum": [
                  "DASP",
                  "DA"
                ]
              }
            },
            "required": [
              "examScope"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "$ref": "#/$defs/sharedSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "examScope": {
                "const": "DAP"
              }
            },
            "required": [
              "examScope"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "$ref": "#/$defs/dapSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "single"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 2
              },
              "correctAnswers": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multiple"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 2
              },
              "correctAnswers": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "descriptive"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "scoringCriteria",
              "requiredConcepts"
            ],
            "properties": {
              "examScope": {
                "const": "DAP"
              },
              "category": {
                "enum": [
                  "데이터 표준화",
                  "데이터 모델링"
                ]
              },
              "choices": {
                "maxItems": 0
              },
              "correctAnswers": {
                "maxItems": 0
              },
              "scoringCriteria": {
                "minItems": 1
              },
              "requiredConcepts": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "x-baeumzip-course-guide": {
    "displayNames": {
      "DASP": "DAsP",
      "DAP": "DAP"
    },
    "contentScopes": {
      "DASP": [
        "DASP",
        "DA"
      ],
      "DAP": [
        "DAP",
        "DA"
      ]
    },
    "subjects": {
      "DASP": [
        "전사아키텍처 이해",
        "데이터 요건 분석",
        "데이터 표준화",
        "데이터 모델링"
      ],
      "DAP": [
        "전사아키텍처 이해",
        "데이터 요건 분석",
        "데이터 표준화",
        "데이터 모델링",
        "데이터베이스 설계와 이용",
        "데이터 품질 관리 이해"
      ]
    },
    "sharedScope": "DA는 두 과정에 공통인 첫 네 과목에만 사용할 수 있습니다.",
    "descriptiveScope": "descriptive는 DAP의 데이터 표준화 또는 데이터 모델링 과목에서만 사용할 수 있습니다."
  },
  "x-baeumzip-storage-mapping": {
    "theories": {
      "id": "theories.id INTEGER PRIMARY KEY",
      "title": "theories.title TEXT",
      "category": "theories.category TEXT",
      "topic": "theories.topic TEXT",
      "sortOrder": "theories.sort_order INTEGER",
      "examScope": "theories.exam_scope TEXT",
      "summary": "theories.summary TEXT",
      "content": "theories.content TEXT",
      "reviewAnswers": "theories.review_answers TEXT",
      "keywords": "theories.keywords TEXT containing a JSON array",
      "active": "theories.active INTEGER containing 1 or 0",
      "createdAt": "theories.created_at TEXT",
      "updatedAt": "theories.updated_at TEXT"
    },
    "questions": {
      "id": "questions.id INTEGER PRIMARY KEY",
      "category": "questions.category TEXT",
      "topic": "questions.topic TEXT",
      "displayOrder": "questions.display_order INTEGER",
      "examScope": "questions.exam_scope TEXT",
      "difficulty": "questions.difficulty TEXT",
      "difficultyRationale": "questions.difficulty_rationale TEXT",
      "kind": "questions.kind TEXT",
      "prompt": "questions.prompt TEXT",
      "choices": "questions.choices TEXT containing a JSON array",
      "correctAnswers": "questions.correct_answers TEXT containing a JSON array",
      "explanation": "questions.explanation TEXT",
      "tags": "questions.tags TEXT containing a JSON array",
      "scoringCriteria": "questions.scoring_criteria TEXT containing a JSON array",
      "requiredConcepts": "questions.required_concepts TEXT containing a JSON array",
      "acceptableAlternatives": "questions.acceptable_alternatives TEXT containing a JSON array",
      "deductionConditions": "questions.deduction_conditions TEXT containing a JSON array",
      "errorConditions": "questions.error_conditions TEXT containing a JSON array",
      "theoryId": "questions.theory_id INTEGER or NULL",
      "practiceScope": "questions.practice_scope TEXT",
      "active": "questions.active INTEGER containing 1 or 0",
      "createdAt": "questions.created_at TEXT",
      "updatedAt": "questions.updated_at TEXT"
    }
  },
  "x-baeumzip-validation-rules": [
    "모든 id는 운영 DB의 기존 ID 및 같은 파일 안의 다른 ID와 겹치면 안 됩니다.",
    "examScope는 canonical code인 DASP, DAP, DA 중 하나를 사용합니다. DAsP 표기는 입력 시 DASP로 정규화되지만 DASP 사용을 권장합니다.",
    "DA 범위는 전사아키텍처 이해, 데이터 요건 분석, 데이터 표준화, 데이터 모델링에만 사용할 수 있습니다.",
    "theoryId를 지정하면 같은 과목의 활성 이론이어야 하고 문제 범위와 이론 범위가 호환되어야 합니다.",
    "correctAnswers는 선택지 번호가 아니라 0부터 시작하는 배열 인덱스입니다.",
    "객관식·복수정답 문제는 두 개 이상의 고유한 선택지, 유효한 정답 인덱스, 정답과 오답을 설명하는 해설이 필요합니다.",
    "DAP 실기형은 choices와 correctAnswers를 빈 배열로 두고 scoringCriteria 및 requiredConcepts를 채웁니다.",
    "Markdown 코드 펜스는 짝이 맞아야 하며 원문·출처 메모 같은 학습 외 부록을 본문에 섞지 않습니다.",
    "관리자 가져오기에서 먼저 미리보기를 실행하고 오류가 0건일 때만 적용합니다."
  ]
}
