# Google OAuth sign-in. Configure all values together in every deployed environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_SESSION_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Administrator allowlist.
ADMIN_EMAIL=admin@example.com

# Embedded canonical recovery is enabled by default. Use disabled only deliberately.
CANONICAL_RECOVERY_SOURCE=embedded

# Required by the scheduled operational-maintenance workflow. Use at least 32 random characters.
MAINTENANCE_TRIGGER_SECRET=

# Keep the compatibility path until a private runtime binding named BACKUP_OBJECTS exists.
# BACKUP_OBJECTS is an object-storage binding, not a text secret in this file.
BACKUP_STORAGE_MODE=database

# Set to true only after the private scheduled backup has demonstrated actual
# success, freshness, and a verified restore. Default keeps admin-entry backup.
BACKUP_SCHEDULE_VERIFIED=false

# Group SKCT stays hidden until migration 0558 and a validated active bank are verified.
SKCT_GROUP_SERVICE_ENABLED=0

# New runs only; existing v2 runs keep draining when disabled.
SKCT_GROUP_V2_ENABLED=0
# Enable only after complete source identity and historical coverage review.
SKCT_GROUP_REPEAT_IDENTITY_VERIFIED=0
