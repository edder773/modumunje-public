{
  "name": "modumunje-public",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "check:backend": "bash scripts/sites-env.sh -- tsc --noEmit -p apps/backend/tsconfig.json",
    "check:types": "bash scripts/sites-env.sh -- tsc --noEmit -p tsconfig.json && npm run check:js",
    "check:js": "tsc --noEmit -p tsconfig.core-js.json",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify:migrations": "node scripts/verify-migration-safety.mjs",
    "build": "bash scripts/sites-env.sh -- vinext build && node --import tsx scripts/generate-static-asset-headers.ts",
    "test": "npm run test:synthetic",
    "test:synthetic": "node --import tsx --test tests/public-synthetic-smoke.test.ts tests/immutable-static-assets.test.ts tests/static-asset-headers.test.ts tests/public-boundary-guard.test.mjs tests/skct-personal-workspace.test.ts tests/group-personal-bank.test.ts tests/group-ux-regressions.test.ts",
    "verify:public": "node scripts/check-public-boundary.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "katex": "0.18.9",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "web-vitals": "4.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.54.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.12"
    },
    "browserslist": "4.28.8",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "undici": "7.29.1",
    "ws": "8.21.0"
  },
  "type": "module",
  "displayName": "모두의 문제집"
}
